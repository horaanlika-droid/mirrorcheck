# Единственные две переменные, которые нужно ввести на бот-хосте.
# Всё остальное (база, курсы, ссылки, меню Telegram) создаётся автоматически.

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AA...

# Telegram ID владельца (узнать: @userinfobot)
ADMIN_ID=123456789

# Необязательно: несколько владельцев через запятую (объединяется с ADMIN_ID).
# Можно использовать ADMIN_IDS вместо ADMIN_ID.
# ADMIN_IDS=123456789,987654321
# Дополнительных операторов владелец добавляет в личном чате бота:
# /addadmin 987654321 — добавить, /removeadmin 987654321 — удалить.
# Каждый админ должен открыть бота и нажать /start.

# Необязательно (есть разумные значения по умолчанию):
# Порт берётся сам: SERVER_PORT (бот-хостинги) → PORT → 8080.
# Не прописывайте PORT=8080 на панели — иначе сайт не откроется и будет «Bot is running».
# Адрес определяется сам и используется только для кнопки меню бота (нигде не показывается).
# PUBLIC_URL=https://ваш-домен.example

# Курсы BTC/GRAM подтягиваются сами из 12 бирж и агрегаторов (медиана) и ЦБ РФ.
# RATES_INTERVAL_MS=10000   # период автообновления, мс
# RATES_DISABLED=1          # выключить автообновление (курс — только кнопкой «🔄 Обновить курс»)

# Кабинет брокера: стартовые логин/пароль для входа через /broker в боте.
# Се́ются в базу при первом запуске, дальше меняются в боте: Меню → Брокеры.
# BROKER_LOGIN=broker
# BROKER_PASSWORD=секретный-пароль
